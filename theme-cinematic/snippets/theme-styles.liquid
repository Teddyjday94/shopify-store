{%- comment -%} Self-hosted fonts and color settings. Rendered in the <head> of every layout. {%- endcomment -%}
{{ 'instrument-serif-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'inter-tight-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  /* Type system: Instrument Serif (display), Inter Tight (text), IBM Plex Mono (labels). All SIL OFL, self-hosted. */
  @font-face { font-family: 'Instrument Serif'; src: url({{ 'instrument-serif-400.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Instrument Serif'; src: url({{ 'instrument-serif-400-italic.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Inter Tight'; src: url({{ 'inter-tight-var.woff2' | asset_url }}) format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'Inter Tight'; src: url({{ 'inter-tight-var-italic.woff2' | asset_url }}) format('woff2'); font-weight: 100 900; font-style: italic; font-display: swap; }
  /* Product titles and other "heavy" text: always semibold, whatever weight a rule asks for. */
  @font-face { font-family: 'Inter Tight Strong'; src: url({{ 'inter-tight-600.woff2' | asset_url }}) format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'IBM Plex Mono'; src: url({{ 'plex-mono-500.woff2' | asset_url }}) format('woff2'); font-weight: 100 500; font-display: swap; }
  @font-face { font-family: 'IBM Plex Mono'; src: url({{ 'plex-mono-600.woff2' | asset_url }}) format('woff2'); font-weight: 600 900; font-display: swap; }
  /* Kept for the hero postcard's stamp lettering only. */
  @font-face { font-family: 'Anton'; src: url({{ 'anton.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Space Mono'; src: url({{ 'space-mono-400.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-display: swap; }
  :root {
    --paper: {{ settings.color_paper }};
    --ink: {{ settings.color_ink }};
    --accent: {{ settings.color_accent }};
    --card: {{ settings.color_card }};
    --muted: {{ settings.color_ink | color_mix: settings.color_paper, 60 }};
    --pop-1: {{ settings.color_pop_1 }};
    --pop-2: {{ settings.color_pop_2 }};
    --pop-3: {{ settings.color_pop_3 }};
    --pop-4: {{ settings.color_pop_4 }};
  }
  /* Hover swap (mouse only): hide the first photo while the second shows, so the two never blend. */
  @media (hover: hover) { .card:hover .card__media img:has(+ img) { opacity: 0; } }
  /* Touch screens: no hover-only reveals. On iPhone a reveal turns the first tap into a "hover",
     so links needed a second tap. */
  @media (hover: none) {
    .card:hover .card__media img { opacity: 1 !important; }
    .card:hover .card__media img + img { opacity: 0 !important; }
    .outfit-frame:hover .outfit-frame__view { opacity: 0 !important; }
  }
</style>
{{ 'theme.css' | asset_url | stylesheet_tag }}
