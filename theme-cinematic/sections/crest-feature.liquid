{%- comment -%}
  Crest feature (2026-11-25, Doomsday Drop): the D Crest artwork beside its products.
  Hides itself after the "ends" date (YYYY-MM-DD, store time zone).
{%- endcomment -%}
{%- liquid
  assign today = 'now' | date: '%Y%m%d' | plus: 0
  assign ends = section.settings.ends | remove: '-' | strip | plus: 0
  assign live = true
  if ends != 0 and today > ends
    assign live = false
  endif
  assign products = section.settings.products
-%}
{%- if live -%}
<section class="crestf" aria-labelledby="crestf-title-{{ section.id }}">
  <div class="page-width">
    <div class="crestf__top">
      <div class="crestf__art">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 40vw, 80vw', loading: 'lazy', alt: section.settings.image_alt }}
        {%- endif -%}
      </div>
      <div class="crestf__copy">
        {%- if section.settings.kicker != blank -%}<p class="label crestf__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 id="crestf-title-{{ section.id }}" class="display display--lg crestf__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="crestf__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_link != blank -%}
          <a class="btn crestf__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} &rarr;</a>
        {%- endif -%}
      </div>
    </div>
    {%- if products != blank -%}
      <div class="grid crestf__grid" style="--cols: {{ products.size | at_most: 4 }};">
        {%- for product in products -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<style>
#shopify-section-{{ section.id }} .crestf { --crest-acid: #4fd16a; padding: 76px 0 64px; background: radial-gradient(90% 80% at 25% 30%, #143a1d 0%, #0a100b 55%, #060806 100%); color: #f2eee5; border-top: 1px solid #4fd16a33; border-bottom: 1px solid #4fd16a33; }
.crestf__top { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: 56px; align-items: center; margin-bottom: 48px; }
.crestf__art { display: flex; justify-content: center; }
.crestf__art img { width: 100%; max-width: 520px; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 38%; display: block; border: 1px solid #4fd16a55; box-shadow: 0 24px 54px #0009, 0 0 34px #4fd16a22; }
.crestf__kicker { color: var(--crest-acid); margin: 0 0 14px; }
.crestf__title { margin: 0 0 18px; color: #f2eee5; text-shadow: 0 0 40px #4fd16a33; }
.crestf__text { max-width: 46ch; font-size: 17px; line-height: 1.55; color: #d6d1c6; margin-bottom: 26px; }
.crestf__text p { margin: 0 0 10px; }
.crestf__btn { background: var(--crest-acid); color: #0a100b; border-color: var(--crest-acid); }
.crestf__btn:hover { background: #f2eee5; color: #0a100b; }
.crestf__grid { gap: 24px; }
#shopify-section-{{ section.id }} .crestf .card, #shopify-section-{{ section.id }} .crestf .card a { color: #f2eee5; }
@media (max-width: 899px) {
  .crestf { padding: 44px 0 40px; }
  .crestf__top { grid-template-columns: 1fr; gap: 24px; margin-bottom: 30px; }
  .crestf__art img { max-width: 340px; }
  .crestf__grid { gap: 16px 10px; }
}
</style>

{% schema %}
{
  "name": "Crest feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Crest image" },
    { "type": "text", "id": "image_alt", "label": "Crest image description", "default": "The D Crest" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Doomsday Drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The D Crest" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Doomsday Drop" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "ends", "label": "Hide after (optional)", "info": "YYYY-MM-DD, store time zone." }
  ],
  "presets": [{ "name": "Crest feature" }]
}
{% endschema %}
