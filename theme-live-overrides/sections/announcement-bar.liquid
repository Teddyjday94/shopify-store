{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  comment
    2026-11-19: a message can carry an "ends" date (YYYY-MM-DD, store time zone); it stops showing after that day.
  endcomment
  assign today = 'now' | date: '%Y%m%d' | plus: 0
  assign shown = 0
  for block in messages
    assign ends = block.settings.ends | remove: '-' | strip | plus: 0
    if ends == 0 or today <= ends
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 -%}
  <div class="announcement label" role="region" aria-label="Announcements" style="--marquee-speed: {{ section.settings.speed }}s;">
    <div class="marquee">
      {%- comment -%} Two copies so the scroll loops seamlessly; the second is hidden from screen readers. {%- endcomment -%}
      {%- for copy in (1..2) -%}
        {%- for block in messages -%}
          {%- assign ends = block.settings.ends | remove: '-' | strip | plus: 0 -%}
          {%- if ends != 0 and today > ends -%}{%- continue -%}{%- endif -%}
          <span class="marquee__item"{% if copy == 2 %} aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}"{% if copy == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds)", "min": 10, "max": 90, "step": 5, "default": 40 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Currently elsewhere" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "ends", "label": "Last day to show (optional)", "info": "YYYY-MM-DD, store time zone. Leave empty to always show." }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
