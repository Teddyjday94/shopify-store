{%- comment -%}
  "Worn elsewhere" lookbook (2026-11-17): street and campaign photos, each linking to the piece being worn.
  Desktop: a 4-column grid. Phones: a swipeable row. Photos come from Shopify Files (the owner's promo shots).
{%- endcomment -%}
<section class="mw-look" aria-labelledby="Look-{{ section.id }}">
  <div class="fg-wrap">
    <header class="mw-look__head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="fg-meta fg-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="Look-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="mw-look__text">{{ section.settings.text }}</p>{%- endif -%}
    </header>
    <ul class="mw-look__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign item = block.settings.product -%}
        {%- if block.settings.image == blank -%}{%- continue -%}{%- endif -%}
        <li class="mw-look__item" {{ block.shopify_attributes }}>
          <a class="mw-look__card" href="{{ item.url | default: routes.all_products_collection_url }}">
            {{ block.settings.image | image_url: width: 900 | image_tag:
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 860px) 24vw, 74vw',
              loading: 'lazy',
              class: 'mw-look__img',
              alt: block.settings.image.alt | default: item.title
            }}
            <span class="mw-look__label">
              <span class="fg-meta mw-look__where">{{ block.settings.caption | escape }}</span>
              {%- if item != blank -%}
                <strong>{{ item.title | escape }}</strong>
                <span class="mw-look__shop fg-meta">Shop the look &rarr;</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .mw-look { padding-block: clamp(48px, 7vw, 104px); background: var(--fg-ink, #151113); color: var(--fg-paper, #f1e5d1); border-top: 1px solid var(--fg-line, #ead7b749); }
  .mw-look__head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 14px 40px; margin-bottom: clamp(20px, 3.5vw, 40px); }
  .mw-look__head .fg-kicker { margin: 0 0 10px; }
  .mw-look__head h2 { margin: 0; font: 400 clamp(3rem, 7vw, 7rem)/.92 var(--fg-display, Anton, Impact, sans-serif); text-transform: uppercase; letter-spacing: -.025em; }
  .mw-look__text { max-width: 36ch; margin: 0; font: 400 1.12rem/1.42 var(--fg-serif, Georgia, serif); color: #e2d5c1; }
  .mw-look__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.4vw, 18px); margin: 0; padding: 0; list-style: none; }
  .mw-look__item:nth-child(4n+2), .mw-look__item:nth-child(4n+4) { transform: translateY(clamp(18px, 3vw, 42px)); }
  .mw-look__grid { padding-bottom: clamp(18px, 3vw, 42px); }
  .mw-look__card { position: relative; display: block; aspect-ratio: 4 / 5.2; overflow: hidden; color: inherit; text-decoration: none; background: #1d1b1c; border: 1px solid var(--fg-line, #ead7b749); }
  .mw-look__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; transition: transform .7s cubic-bezier(.22, 1, .36, 1); }
  .mw-look__card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, #100b10f0 0%, #100b1080 26%, transparent 52%); pointer-events: none; }
  .mw-look__label { position: absolute; z-index: 1; inset: auto 0 0 0; display: grid; gap: 6px; padding: clamp(12px, 1.4vw, 18px); }
  .mw-look__where { color: var(--fg-gold, #e7b681); }
  .mw-look__label strong { font: 600 clamp(1rem, 1.4vw, 1.2rem)/1.15 var(--support, "Barlow Semi Condensed", sans-serif); }
  .mw-look__shop { opacity: .8; }
  .mw-look__card:hover .mw-look__shop, .mw-look__card:focus-visible .mw-look__shop { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    html:not(.motion-paused) .mw-look__card:hover .mw-look__img { transform: scale(1.045); }
  }
  @media (max-width: 860px) {
    .mw-look__grid {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(74vw, 320px);
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px;
      margin-inline: calc(-1 * clamp(16px, 4.5vw, 76px)); padding-inline: clamp(16px, 4.5vw, 76px); scroll-padding-inline: clamp(16px, 4.5vw, 76px);
    }
    .mw-look__grid::-webkit-scrollbar { display: none; }
    .mw-look__item { scroll-snap-align: start; }
    .mw-look__item:nth-child(n) { transform: none; }
  }
</style>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Field notes / Seen out there" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn elsewhere" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Corner stores, subway platforms, arcades at 2am. Where the pieces actually end up." }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "product", "id": "product", "label": "Product being worn" },
        { "type": "text", "id": "caption", "label": "Where", "default": "Downtown" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Lookbook" }]
}
{% endschema %}
