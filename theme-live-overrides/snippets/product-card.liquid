{% doc %}
@param {product} product - Product to display
@param {number} [index] - Position in the current collection
@param {boolean} [lazy] - Lazy-load the main product image
{% enddoc %}
{%- liquid
  assign lazy_load = true
  if lazy == false
    assign lazy_load = false
  endif
  assign loading = 'lazy'
  unless lazy_load
    assign loading = 'eager'
  endunless

  # Hoodies preview their back print: the photo labeled "... in Black, back print" (or any back print),
  # with the front (if printed) as the hover image. Everything else uses the product's first photo.
  assign preview = product.featured_media
  assign hover = product.media[1]
  if product.title contains 'Hoodie'
    assign back_any = nil
    assign back_black = nil
    assign front_any = nil
    for media in product.media
      if media.alt contains ', back print'
        if back_any == nil
          assign back_any = media
        endif
        if back_black == nil and media.alt contains ' in Black,'
          assign back_black = media
        endif
      elsif media.alt contains ', front print' and front_any == nil
        assign front_any = media
      endif
    endfor
    if back_black
      assign preview = back_black
    elsif back_any
      assign preview = back_any
    endif
    if preview != product.featured_media
      assign hover = front_any
    endif
  endif
-%}
{%- liquid
  assign hover_class = 'card__hover'
  assign lifestyle_hover = nil
  case product.handle
    when 'd-crest-varsity-jacket'
      assign lifestyle_hover = images['doomsday-d-crest-varsity-friends.png']
    when 'd-crest-tee'
      assign lifestyle_hover = images['doomsday-d-crest-tee-group.png']
    when 'king-of-the-3-realms-hoodie'
      assign lifestyle_hover = images['doomsday-king-3-realms-hoodie-aisle.png']
    when 'no-gods-only-doom-tee'
      assign lifestyle_hover = images['doomsday-no-gods-tee-concessions.png']
    when 'a-stolen-life-tee'
      assign lifestyle_hover = images['doomsday-a-stolen-life-tee-porch.png']
    when 'a-stolen-life-hoodie'
      assign lifestyle_hover = images['doomsday-a-stolen-life-hoodie-sidewalk.png']
  endcase
  if lifestyle_hover != blank
    assign hover = lifestyle_hover
    assign hover_class = 'card__hover card__hover--lifestyle'
  endif
-%}
{%- comment -%} The card is a frame holding the product link plus a quick view button (a button can't sit inside a link). {%- endcomment -%}
<div class="card outfit-frame">
<a class="card__link" href="{{ product.url }}">
  <div class="outfit-frame__rail label"><span>{% if index %}Piece {{ index | prepend: '00' | slice: -3, 3 }}{% else %}Elsewhere issue{% endif %}</span><span>{{ product.type | default: 'In rotation' | escape }}</span></div>
  <div class="card__media">
    {%- if product.available == false -%}
      <span class="card__tag stamp">{{ 'products.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="card__tag stamp">{{ 'products.on_sale' | t }}</span>
    {%- endif -%}

    {%- if preview -%}
      {{ preview | image_url: width: 1440 | image_tag:
        widths: '360, 540, 720, 1000, 1440',
        sizes: '(min-width: 1440px) 450px, (min-width: 990px) 31vw, 50vw',
        loading: loading,
        alt: preview.alt | default: product.title
      }}
      {%- if settings.card_show_second_image and hover -%}
        {{ hover | image_url: width: 1440 | image_tag:
          widths: '360, 540, 720, 1000, 1440',
          sizes: '(min-width: 1440px) 450px, (min-width: 990px) 31vw, 50vw',
          loading: 'lazy',
          class: hover_class,
          alt: ''
        }}
      {%- endif -%}
    {%- endif -%}
    <span class="outfit-frame__view label" aria-hidden="true">View piece &nearr;</span>
  </div>
  <div class="card__info">
    <h3 class="card__title">{{ product.title }}</h3>
    {%- if settings.card_tag != blank -%}
      <span class="label muted">{{ settings.card_tag }}</span>
    {%- endif -%}
    <div class="card__meta">
      {% render 'price', product: product %}
      <span class="label" aria-hidden="true">&rarr;</span>
    </div>
  </div>
</a>
<button class="card__quick" type="button" data-quick-view="{{ product.handle }}" data-quick-url="{{ product.url }}" aria-haspopup="dialog" aria-label="Quick view: {{ product.title | escape }}">
  Quick view
  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
</button>
</div>
