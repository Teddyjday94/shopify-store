<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div>
        <div class="box footer__reply">
          <dl class="kv label">
            <dt>Re:</dt><dd>{{ section.settings.reply_subject }}</dd>
          </dl>
          <hr class="rule rule--dashed" style="margin: 14px 0;">
          <div class="rte">{{ section.settings.reply_body }}</div>
        </div>

        {%- if section.settings.show_newsletter -%}
          <div style="margin-top: 22px;">
            <p class="label" style="margin: 0 0 8px;">{{ section.settings.newsletter_heading }}</p>
            {%- form 'customer', id: 'FooterNewsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="notice" role="status">{{ 'newsletter.success' | t }}</p>
              {%- else -%}
                {%- if form.errors -%}
                  <p class="notice notice--error" role="alert">{{ form.errors | default_errors }}</p>
                {%- endif -%}
                <div class="inline-form">
                  <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
                  <input class="input" id="FooterNewsletterEmail" type="email" name="contact[email]" required
                    autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}">
                  <button class="btn" type="submit">{{ 'newsletter.submit' | t }}</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <p class="label" style="margin: 0 0 10px;">{{ block.settings.heading }}</p>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom label">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ section.settings.small_print }}</span>
    </div>
  </div>
  {%- if section.settings.show_wordmark -%}
    <p class="display footer__word" aria-hidden="true">{{ section.settings.wordmark }}</p>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "reply_subject", "label": "Auto-reply subject", "default": "Out of office" },
    { "type": "richtext", "id": "reply_body", "label": "Auto-reply message", "default": "<p>Thanks for stopping by. Everything here is printed to order, just for you, then shipped wherever you are. Questions? Reply anytime. We'll answer when we're back from elsewhere.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Email signup heading", "default": "Get notified about new drops" },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Made elsewhere. Worn here." },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show big wordmark", "default": true },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Elsewhere" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
