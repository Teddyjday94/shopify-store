{%- paginate blog.articles by 12 -%}
  <div class="collection-hero">
    <div class="page-width"><h1 class="display display--lg">{{ blog.title }}</h1></div>
  </div>
  <section class="section section--tight">
    <div class="page-width">
      <div class="grid">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            {%- if article.image -%}
              <div class="card__media">
                {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', alt: article.image.alt | default: article.title }}
              </div>
            {%- endif -%}
            <div class="card__info">
              <span class="label muted">{{ article.published_at | date: '%b %d, %Y' }}</span>
              <h2 class="card__title">{{ article.title }}</h2>
              <p class="muted" style="margin: 0;">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
