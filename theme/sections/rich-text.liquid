<section class="section">
  <div class="page-width page-narrow" style="text-align: {{ section.settings.align }};">
    {%- if section.settings.kicker != blank -%}
      <p class="label muted" style="margin: 0 0 10px;">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="display display--md" style="margin-bottom: 18px;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="rte" style="font-size: 17px;">{{ section.settings.text }}</div>
    {%- if section.settings.stamp != blank -%}
      <p style="margin-top: 22px;"><span class="stamp">{{ section.settings.stamp }}</span></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share something about your store.</p>" },
    { "type": "text", "id": "stamp", "label": "Stamp text" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
