<section class="section" style="min-height: 100vh; display: grid; place-items: center;">
  <div class="page-width page-narrow" style="text-align: center;">
    <p style="margin: 0 0 20px;"><span class="stamp">{{ section.settings.stamp }}</span></p>
    <h1 class="display display--xl">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p style="font-size: 17px; margin: 18px 0 28px;">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="notice notice--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="inline-form" style="max-width: 420px; margin: 0 auto;">
        <label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label>
        <input class="input" id="Password" type="password" name="password" autocomplete="current-password"
          placeholder="{{ 'password.enter' | t }}">
        <button class="btn" type="submit">{{ 'password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "stamp", "label": "Stamp text", "default": "Out of office" }
  ]
}
{% endschema %}
