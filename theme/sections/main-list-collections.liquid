<div class="collection-hero">
  <div class="page-width">
    <h1 class="display display--lg">{{ section.settings.heading }}</h1>
  </div>
</div>
<section class="section section--tight">
  <div class="page-width labels">
    {%- for c in collections -%}
      {%- if c.handle != 'frontpage' and c.products_count > 0 -%}
        <a class="ship-label" href="{{ c.url }}">
          <div class="ship-label__top label">
            <span>Dept. {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span>{{ 'collections.count' | t: count: c.products_count }}</span>
          </div>
          <span class="display">{{ c.title }}</span>
          <hr class="rule rule--dashed">
          <div class="barcode barcode--sm"></div>
          <span class="label">Open &rarr;</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All departments" }
  ]
}
{% endschema %}
