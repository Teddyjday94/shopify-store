{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="section section--tight">
  <div class="page-width product" data-product data-section="{{ section.id }}">
    <div class="gallery">
      <div class="gallery__main">
        {%- if current_media -%}
          {{ current_media | image_url: width: 1400 | image_tag:
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 860px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: current_media.alt | default: product.title
          }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs" aria-label="Product images">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button class="gallery__thumb" type="button"
                data-media-id="{{ media.id }}"
                data-src="{{ media | image_url: width: 1400 }}"
                data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1400 }} 1400w"
                aria-label="Show image {{ forloop.index }}"
                aria-current="{% if media.id == current_media.id %}true{% else %}false{% endif %}">
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <div class="box product__label">
        <div class="label" style="display: flex; justify-content: space-between; gap: 12px;">
          <span>From: {{ shop.name }}</span>
          <span>To: You, eventually</span>
        </div>
        <div class="barcode barcode--sm" style="margin-top: 12px;"></div>

        <h1 class="display product__title">{{ product.title }}</h1>

        <p class="product__price" data-product-price>{% render 'price', variant: current_variant %}</p>
        <p class="label muted" style="margin: 0;">{{ 'cart.taxes_shipping' | t }}</p>

        <hr class="rule rule--dashed">

        {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="option">
                <legend class="label">{{ option.name }}: <span data-option-label="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
                <div class="option__values">
                  {%- assign option_index = forloop.index0 -%}
                  {%- for value in option.values -%}
                    {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                    <input type="radio" id="{{ input_id }}" name="option-{{ option_index }}"
                      value="{{ value | escape }}" data-option-index="{{ option_index }}"
                      {% if option.selected_value == value %}checked{% endif %}>
                    <label for="{{ input_id }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <div class="buy">
            <div class="qty">
              <button type="button" data-qty="-1" aria-label="{{ 'products.decrease' | t }}">&minus;</button>
              <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
              <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" data-qty="1" aria-label="{{ 'products.increase' | t }}">+</button>
            </div>
            <button class="btn btn--block" type="submit" name="add" data-add-button
              {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}
                {{ 'products.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
          <p class="form-error" role="alert" data-form-error hidden></p>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product__desc rte">{{ product.description }}</div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <details class="details" {{ block.shopify_attributes }}>
          <summary class="label">{{ block.settings.heading }}</summary>
          <div class="rte">
            {{ block.settings.content }}
            {{ block.settings.page.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{% schema %}
{
  "name": "Product page",
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from a page" }
      ]
    }
  ]
}
{% endschema %}
