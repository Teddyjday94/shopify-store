{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
-%}
<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}
          <p class="label muted" style="margin: 0 0 8px;">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h2 class="display display--lg">{{ section.settings.heading }}</h2>
      </div>
      <a class="btn btn--ghost" href="{{ collection.url }}">{{ section.settings.link_label }} &rarr;</a>
    </div>

    {%- if collection.products_count > 0 -%}
      <div class="grid" style="--cols: {{ section.settings.columns }};">
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Drop 001" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The launch drop" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
