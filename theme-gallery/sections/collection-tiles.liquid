{%- comment -%}
  "Shop by collection": image tiles with the name over a gradient, like browsing artist shops or themes.
{%- endcomment -%}
<section class="section tiles">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <ul class="tiles__grid" role="list" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign img = block.settings.image | default: c.image | default: c.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="tile" href="{{ c.url }}">
            {%- if img -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: '', class: 'tile__img', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw' }}
            {%- endif -%}
            <span class="tile__copy">
              <span class="tile__name">{{ block.settings.title | default: c.title }}</span>
              <span class="tile__count">{{ c.products_count }} pieces {% render 'icon', name: 'arrow' %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Collection tiles", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
