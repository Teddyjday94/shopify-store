{%- comment -%}
  "Shop by product": a row of round (or square) tiles, one per collection, that scrolls sideways on small screens.
  Image: the block's image, else the collection image, else its first product's image.
{%- endcomment -%}
<section class="section cats" style="padding-top: {{ section.settings.pad_top }}px;">
  <div class="page-width">
    <div class="section-head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <ul class="cats__row cats__row--{{ section.settings.shape }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign img = block.settings.image | default: c.image | default: c.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="cat" href="{{ c.url | default: '#' }}">
            <span class="cat__img">
              {%- if img -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '200, 300, 400', sizes: '160px' }}{%- endif -%}
            </span>
            <span class="cat__name">{{ block.settings.title | default: c.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category scroller",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by product" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "shape", "label": "Tile shape", "default": "round", "options": [
      { "value": "round", "label": "Round" }, { "value": "square", "label": "Rounded square" }
    ] },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Category scroller", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
