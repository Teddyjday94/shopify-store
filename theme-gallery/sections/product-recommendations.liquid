{%- comment -%}
  "You might also like": Shopify's related products, loaded by assets/theme.js through the Section Rendering
  API once the section scrolls near. Other styles of the same design are skipped.
{%- endcomment -%}
<section class="section" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=12&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- capture own -%}{% render 'design-key', handle: recommendations.source.handle, part: 'base' %}{%- endcapture -%}
    {%- capture cards -%}
      {%- assign shown = 0 -%}
      {%- for p in recommendations.products -%}
        {%- capture b -%}{% render 'design-key', handle: p.handle, part: 'base' %}{%- endcapture -%}
        {%- if b == own or shown >= section.settings.limit -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {% render 'product-card', product: p %}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if shown > 0 -%}
      <div class="page-width" data-recs-loaded>
        <div class="section-head"><h2 class="h2">{{ section.settings.heading }}</h2></div>
        <div class="grid grid--scroll" style="--cols: 5;">{{ cards }}</div>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 10, "step": 1, "default": 5 }
  ]
}
{% endschema %}
