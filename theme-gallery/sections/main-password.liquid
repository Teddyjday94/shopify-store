<section class="section pw">
  <div class="page-width page-narrow empty">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h1 class="h1">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'signup signup--center' -%}
      {%- if form.errors -%}<p class="signup__err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label>
      <input class="signup__input" id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.enter' | t }}">
      <button class="btn" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "kicker", "label": "Kicker", "default": "Opening soon" }]
}
{% endschema %}
