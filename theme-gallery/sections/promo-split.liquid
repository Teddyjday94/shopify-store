{%- comment -%} Two promo cards side by side (or one wide), each with image, copy and button. {%- endcomment -%}
<section class="section promos">
  <div class="page-width promos__grid" style="--cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }};">
    {%- for block in section.blocks -%}
      <a class="promo" href="{{ block.settings.link | default: routes.all_products_collection_url }}" style="--promo-bg: {{ block.settings.bg }}; --promo-fg: {{ block.settings.ink }};" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '', class: 'promo__img', widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {%- endif -%}
        <span class="promo__copy">
          {%- if block.settings.kicker != blank -%}<span class="kicker">{{ block.settings.kicker }}</span>{%- endif -%}
          <span class="promo__title">{{ block.settings.heading }}</span>
          {%- if block.settings.text != blank -%}<span class="promo__text">{{ block.settings.text }}</span>{%- endif -%}
          {%- if block.settings.button_label != blank -%}<span class="btn btn--light">{{ block.settings.button_label }}</span>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo cards",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "promo",
      "name": "Promo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "bg", "label": "Color", "default": "#141414" },
        { "type": "color", "id": "ink", "label": "Text", "default": "#FFFFFF" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts under $30" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Promo cards", "blocks": [{ "type": "promo" }, { "type": "promo" }] }]
}
{% endschema %}
