{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  comment
    A message can carry a "starts" and an "ends" date (YYYY-MM-DD, store time zone).
  endcomment
  assign today = 'now' | date: '%Y%m%d' | plus: 0
  assign shown = 0
  for block in messages
    assign ends = block.settings.ends | remove: '-' | strip | plus: 0
    assign starts = block.settings.starts | remove: '-' | strip | plus: 0
    if ends == 0 or today <= ends
      if today >= starts
        assign shown = shown | plus: 1
      endif
    endif
  endfor
-%}
{%- if shown > 0 -%}
  <div class="announce" role="region" aria-label="Announcements" data-announce data-interval="{{ section.settings.interval }}">
    <div class="page-width announce__inner">
      {%- if shown > 1 -%}
        <button class="announce__step" type="button" data-announce-prev aria-label="Previous announcement">{% render 'icon', name: 'arrow-left' %}</button>
      {%- endif -%}
      <div class="announce__track">
        {%- assign n = 0 -%}
        {%- for block in messages -%}
          {%- assign ends = block.settings.ends | remove: '-' | strip | plus: 0 -%}
          {%- assign starts = block.settings.starts | remove: '-' | strip | plus: 0 -%}
          {%- if ends != 0 and today > ends -%}{%- continue -%}{%- endif -%}
          {%- if today < starts -%}{%- continue -%}{%- endif -%}
          <p class="announce__msg{% if n == 0 %} is-active{% endif %}" {% if n > 0 %}aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </p>
          {%- assign n = n | plus: 1 -%}
        {%- endfor -%}
      </div>
      {%- if shown > 1 -%}
        <button class="announce__step" type="button" data-announce-next aria-label="Next announcement">{% render 'icon', name: 'arrow' %}</button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "range", "id": "interval", "label": "Seconds per message", "min": 3, "max": 12, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free US shipping on orders $60+" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "starts", "label": "First day to show (optional)", "info": "YYYY-MM-DD, store time zone. Leave empty to show right away." },
        { "type": "text", "id": "ends", "label": "Last day to show (optional)", "info": "YYYY-MM-DD, store time zone. Leave empty to always show." }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
