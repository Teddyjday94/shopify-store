{%- comment -%} A row of short promises with icons (printed to order, free shipping...). {%- endcomment -%}
<section class="section section--tight props">
  <div class="page-width">
    <ul class="props__row" role="list">
      {%- for block in section.blocks -%}
        <li class="prop" {{ block.shopify_attributes }}>
          <span class="prop__icon">{% render 'icon', name: block.settings.icon %}</span>
          <span>
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}<span class="muted">{{ block.settings.text }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Promises row",
  "blocks": [
    {
      "type": "prop",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "print", "options": [
          { "value": "print", "label": "Printer" }, { "value": "truck", "label": "Truck" },
          { "value": "return", "label": "Return arrow" }, { "value": "spark", "label": "Spark" }, { "value": "heart", "label": "Heart" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Printed to order" },
        { "type": "text", "id": "text", "label": "Text", "default": "Made just for you, one at a time" }
      ]
    }
  ],
  "presets": [{ "name": "Promises row", "blocks": [{ "type": "prop" }, { "type": "prop" }, { "type": "prop" }] }]
}
{% endschema %}
