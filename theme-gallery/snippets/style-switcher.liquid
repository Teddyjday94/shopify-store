{%- comment -%}
  "Available on": the same design on every product style it comes in (tee, women's tee, hoodie, mug, hats...),
  found by the handle convention <design>-<style> in snippets/design-key.liquid. Shown when there are 2+ styles.
  A page can look up at most 20 products by handle, so keep this list at 18 suffixes or fewer.
  @param product
{%- endcomment -%}
{%- capture base -%}{% render 'design-key', handle: product.handle, part: 'base' %}{%- endcapture -%}
{%- liquid
  assign suffixes = '-tee|-womens-tee|-hoodie|-crewneck|-long-sleeve-tee|-sleeve-edition-hoodie|-dad-hat|-trucker-hat|-bucket-hat|-cuffed-beanie|-beanie|-mug|-desk-mat|-ornament|-sticker|-poster|-tote-bag|-phone-case' | split: '|'
  assign labels = "Tee|Women's tee|Hoodie|Crewneck|Long sleeve|Sleeve Edition|Dad hat|Trucker hat|Bucket hat|Beanie|Beanie|Mug|Desk mat|Ornament|Sticker|Poster|Tote bag|Phone case" | split: '|'
  assign found = 0
  for suffix in suffixes
    assign h = base | append: suffix
    if all_products[h].title != blank
      assign found = found | plus: 1
    endif
  endfor
-%}
{%- if found > 1 -%}
  <fieldset class="picker picker--styles">
    <legend class="picker__legend">{{ 'products.available_on' | t }} <span class="muted">{{ found }} styles</span></legend>
    <ul class="styles" role="list">
      {%- for suffix in suffixes -%}
        {%- assign h = base | append: suffix -%}
        {%- assign p = all_products[h] -%}
        {%- if p.title == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign shot = p.featured_media
          if p.title contains 'Hoodie'
            for m in p.media
              if m.alt contains ' in Black, back print'
                assign shot = m
                break
              endif
            endfor
          endif
        -%}
        <li>
          <a class="style{% if p.id == product.id %} is-current{% endif %}" href="{{ p.url }}"{% if p.id == product.id %} aria-current="page"{% endif %}>
            <span class="style__img">{% if shot %}{{ shot | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</span>
            <span class="style__name">{{ labels[forloop.index0] }}</span>
            <span class="style__price">{{ p.price | money_without_trailing_zeros }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </fieldset>
{%- endif -%}
