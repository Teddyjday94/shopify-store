{%- comment -%} @param paginate {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a class="pagination__step" href="{{ paginate.previous.url }}" aria-label="{{ 'pagination.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a class="pagination__step" href="{{ paginate.next.url }}" aria-label="{{ 'pagination.next' | t }}">{% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
