{%- comment -%}
  Koozie multi-buy prices, shown on products tagged "koozie". Must match the automatic discounts in admin:
  2+ $8, 4+ $7.50, 6+ $7 each.
{%- endcomment -%}
<div class="deal" role="note" aria-label="Koozie multi-buy prices">
  <p class="deal__head"><strong>Buy more, pay less</strong> &middot; mix any designs and colors</p>
  <ol class="deal__tiers" role="list">
    <li><span>1</span><strong>$9.99</strong></li>
    <li><span>2+</span><strong>$8 <small>each</small></strong></li>
    <li><span>4+</span><strong>$7.50 <small>each</small></strong></li>
    <li class="is-best"><span>6+</span><strong>$7 <small>each</small></strong></li>
  </ol>
  <p class="muted small">The price drops automatically in your cart.</p>
</div>
