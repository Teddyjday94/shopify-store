{%- comment -%}
  Groups products by design using the handle convention <design>-<style> (born-ready-tee, born-ready-womens-tee,
  born-ready-hoodie, ...). Outputs one value, chosen by `part`:
    base   the design part of the handle (born-ready)
    label  the style name shown to shoppers (Tee, Women's tee, Hoodie, ...)
    kind   the filter group (tee, womens, hoodie, crewneck, longsleeve, extras)
    rank   sort order of the style (Tee first)
  Usage: {% capture base %}{% render 'design-key', handle: product.handle, part: 'base' %}{% endcapture %}
  Longer suffixes come first so "-womens-tee" wins over "-tee".
{%- endcomment -%}
{%- liquid
  assign suffixes = '-sleeve-edition-hoodie|-long-sleeve-tee|-womens-tee|-tee|-hoodie|-crewneck|-dad-hat|-trucker-hat|-bucket-hat|-cuffed-beanie|-beanie|-mug|-desk-mat|-ornament|-sticker|-poster|-tote-bag|-phone-case' | split: '|'
  assign labels = "Sleeve Edition hoodie|Long sleeve|Women's tee|Tee|Hoodie|Crewneck|Dad hat|Trucker hat|Bucket hat|Beanie|Beanie|Mug|Desk mat|Ornament|Sticker|Poster|Tote bag|Phone case" | split: '|'
  assign kinds = 'hoodie|longsleeve|womens|tee|hoodie|crewneck|extras|extras|extras|extras|extras|extras|extras|extras|extras|extras|extras|extras' | split: '|'
  assign ranks = '5|4|1|0|2|3|6|6|6|6|6|7|8|8|8|8|8|8' | split: '|'
  assign out_base = handle
  assign out_label = 'Original'
  assign out_kind = 'extras'
  assign out_rank = '9'
  for suffix in suffixes
    assign n = suffix.size
    assign neg = 0 | minus: n
    assign tail = handle | slice: neg, n
    if tail == suffix and handle.size > n
      assign keep = handle.size | minus: n
      assign out_base = handle | slice: 0, keep
      assign out_label = labels[forloop.index0]
      assign out_kind = kinds[forloop.index0]
      assign out_rank = ranks[forloop.index0]
      break
    endif
  endfor
  case part
    when 'base'
      echo out_base
    when 'label'
      echo out_label
    when 'kind'
      echo out_kind
    when 'rank'
      echo out_rank
  endcase
-%}
