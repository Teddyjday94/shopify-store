{%- comment -%} Self-hosted font and color settings. Rendered in the <head> of every layout. {%- endcomment -%}
{{ 'inter-tight-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Inter Tight';
    src: url({{ 'inter-tight-var.woff2' | asset_url }}) format('woff2');
    font-weight: 100 900;
    font-display: swap;
  }
  :root {
    --bg: {{ settings.color_bg }};
    --ink: {{ settings.color_ink }};
    --tile: {{ settings.color_tile }};
    --accent: {{ settings.color_accent }};
    --accent-ink: {{ settings.color_accent_text }};
    --sale: {{ settings.color_sale }};
    --promo: {{ settings.color_promo }};
    --promo-ink: {{ settings.color_promo_text }};
    --muted: {{ settings.color_ink | color_mix: settings.color_bg, 58 }};
    --line: {{ settings.color_ink | color_mix: settings.color_bg, 12 }};
    --soft: {{ settings.color_ink | color_mix: settings.color_bg, 5 }};
    --accent-soft: {{ settings.color_accent | color_mix: settings.color_bg, 12 }};
    --radius: {{ settings.radius }}px;
    --page: {{ settings.page_width }}px;
  }
</style>
{{ 'theme.css' | asset_url | stylesheet_tag }}
